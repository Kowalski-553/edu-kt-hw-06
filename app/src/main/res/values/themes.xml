    <!-- тема для сплэш-скрина-->
    <style name="Theme.App.Starting" parent="Theme.SplashScreen">
        <!-- фон экрана -->
        <item name="windowSplashScreenBackground">@color/gray_primary</item>
        <!-- иконка -->
        <item name="windowSplashScreenAnimatedIcon">@mipmap/ic_launcher_round</item>
        <!-- тема после сплэш-скрина -->
        <item name="postSplashScreenTheme">@style/Theme.Edukthw06</item>
