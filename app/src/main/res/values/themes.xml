<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- для всех TextView теперь базвый шрифт - Geologica.M3-начертания переопределены в type.xml -->
    <style name="Theme.Edukthw06" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="android:fontFamily">@font/app_font</item>
        <item name="fontFamily">@font/app_font</item>
    </style>

    <!-- тема для сплэш-скрина-->
    <style name="Theme.App.Starting" parent="Theme.SplashScreen">
        <!-- фон экрана -->
        <item name="windowSplashScreenBackground">@color/gray_primary</item>
        <!-- иконка -->
        <item name="windowSplashScreenAnimatedIcon">@mipmap/ic_launcher_round</item>
        <!-- тема после сплэш-скрина -->
        <item name="postSplashScreenTheme">@style/Theme.Edukthw06</item>
    </style>

    <style name="Widget.App.Button" parent="Widget.Material3.Button">
        <item name="backgroundTint">@color/button_bg_tint</item>
        <item name="android:textColor">@color/button_text_color</item>
        <item name="cornerRadius">5dp</item>
    </style>

    <style name="Widget.App.Button.Outlined" parent="Widget.Material3.Button.OutlinedButton">
        <item name="cornerRadius">5dp</item>
    </style>
</resources>